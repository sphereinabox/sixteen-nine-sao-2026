	(gr_text "Lumissil IS31FL3731 i2c LED driver and CH32V003F4U6\n\nJP6 1-2: connect IS31 INT pin to SAO_GPIO1 (default)\nJP6 2-3: connect IS31 INT pin to ch32v\n\nJP7 1-2: connect IS31 INT pin to SAO_GPIO2 (default)\nJP7 2-3: connect IS31 INT pin to ch32v\n\nConnect JP4, JP5 to connect SAO I2C and IS31 I2C\nIS31FL3731 is at default address 0x74\n\nCH32V003 programming on 2mm pitch J3"
		(at 55.372 21.844 0)
		(layer "B.SilkS")
		(uuid "ffb276b4-b27f-40f3-b576-6bc6af10425d")
		(effects
			(font
				(size 0.889 0.889)
				(thickness 0.1)
			)
			(justify left top mirror)
		)
	)
